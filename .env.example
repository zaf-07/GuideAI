# --- GuideLens gateway ----------------------------------------------------
# The gateway is never in the safety loop. Obstacle detection, distance and
# collision warning all run on the phone; this service only produces spoken
# descriptions. If it is down, safety behaviour is unchanged.

# Nebius (OpenAI-compatible). The key stays on the server: the app
# authenticates as its own device and never holds it.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# Model IDs live in config, not code. Hosted catalogs churn, and an unknown
# model fails loudly rather than silently changing what a blind user hears.
# Narration is chosen on latency; dialogue runs only on explicit request.
NEBIUS_NARRATION_MODEL=nvidia/Nemotron-3-Nano-Omni
NEBIUS_DIALOGUE_MODEL=Qwen/Qwen3-VL-32B-Instruct
NEBIUS_NARRATION_MAX_TOKENS=48
NEBIUS_DIALOGUE_MAX_TOKENS=160

# Published prices per 1M tokens, used only for the cost field in the logs.
NEBIUS_INPUT_COST_PER_MTOK=0.06
NEBIUS_OUTPUT_COST_PER_MTOK=0.24

# Rate limits bound how often a device may call; this bounds what it may
# spend, so one looping client cannot drain the credits.
GUIDELENS_DEVICE_TOKENS_PER_HOUR=250000
GUIDELENS_MAX_FRAME_BYTES=524288

# Optional allowlist of device IDs. Empty means any device that can prove its
# own 256-bit secret is accepted.
GUIDELENS_DEVICE_IDS=

CORS_ORIGINS=

# --- Supermemory (optional) ----------------------------------------------
# Relationship-based memory. Blank leaves the gateway with no memory sync.
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# === Web app and API (apps/) ===============================================
# Everything below is read by apps/api and apps/mobile, not by the gateway.
# SUPERMEMORY_* and CORS_ORIGINS above are shared with apps/api.

EXPO_PUBLIC_API_URL=http://localhost:8000
# Opt-in developer overlay for detections.
EXPO_PUBLIC_VISION_DEBUG=false
# Scene descriptions and sign reading. Providers are tried in order; with no
# key at all, answers come from the on-device detector only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M3.1-Flash
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
VISION_PROVIDERS=gemini,minimax,groq
# Optional deployment-wide Shared Sight gate. Every client also generates a
# separate high-entropy device secret that the API binds to its stable ID.
# Configure this shared key before upgrading an existing SQLite database so
# legacy device IDs can securely enroll their new per-device credential.
SHARED_SIGHT_TOKEN=
SHARED_SIGHT_DEVICE_IDS=
CAMPUS_ALERT_TTL_HOURS=12
OBSERVATION_MIN_CONFIDENCE=0.65
OBSERVATION_VERIFIED_SHARED_MIN_CONFIDENCE=0.40
MAX_IMAGE_BYTES=1500000
MAX_CONCURRENCY=4
MIN_REQUEST_INTERVAL=1.5
# Hazard detector. The weights are fetched on first use. Review the
# Ultralytics AGPL-3.0 / Enterprise terms before distributing a build with it.
YOLO_ENABLED=true
YOLO_MODEL=yolo11n.pt
# auto, cpu, mps, cuda:0 ...
YOLO_DEVICE=auto
YOLO_MIN_CONFIDENCE=0.35
# Deaf-Blind bridge conversations are forgotten after this long without a message.
BRIDGE_TTL_HOURS=12

# --- Family: contacts and messages ------------------------------------------
# Contacts and saved places are kept per device in this SQLite file.
# FAMILY_DB=apps/api/data/family.sqlite3
# With Twilio credentials a confirmed message is delivered directly. Without
# them WhatsApp opens on the phone with the message ready to send.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# MESSAGE_SENDS_PER_HOUR=10

# --- Payments ----------------------------------------------------------------
# Only Stripe test keys (sk_test_... or rk_test_...) are accepted; a live key
# is refused. Empty means every payment is simulated.
# STRIPE_SECRET_KEY=
# PAY_MAX_CENTS=5000

# --- Voice (optional) --------------------------------------------------------
# Without a key the phone's own voice is used.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# SPEECH_VOICE=minimax
