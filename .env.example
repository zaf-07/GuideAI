EXPO_PUBLIC_API_URL=http://localhost:8000
# Opt-in developer overlay for detections.
EXPO_PUBLIC_VISION_DEBUG=false
# Scene descriptions and sign reading. Providers are tried in order; with no
# key at all, answers come from the on-device detector only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M3.1-Flash
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
VISION_PROVIDERS=gemini,minimax,groq
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
# Optional deployment-wide Shared Sight gate. Every client also generates a
# separate high-entropy device secret that the API binds to its stable ID.
# Configure this shared key before upgrading an existing SQLite database so
# legacy device IDs can securely enroll their new per-device credential.
SHARED_SIGHT_TOKEN=
SHARED_SIGHT_DEVICE_IDS=
CAMPUS_ALERT_TTL_HOURS=12
OBSERVATION_MIN_CONFIDENCE=0.65
OBSERVATION_VERIFIED_SHARED_MIN_CONFIDENCE=0.40
MAX_IMAGE_BYTES=1500000
MAX_CONCURRENCY=4
MIN_REQUEST_INTERVAL=1.5
# Hazard detector. The weights are fetched on first use. Review the
# Ultralytics AGPL-3.0 / Enterprise terms before distributing a build with it.
YOLO_ENABLED=true
YOLO_MODEL=yolo11n.pt
# auto, cpu, mps, cuda:0 ...
YOLO_DEVICE=auto
YOLO_MIN_CONFIDENCE=0.35
# Deaf-Blind bridge conversations are forgotten after this long without a message.
BRIDGE_TTL_HOURS=12

# --- Family: contacts and messages ------------------------------------------
# Contacts and saved places are kept per device in this SQLite file.
# FAMILY_DB=apps/api/data/family.sqlite3
# With Twilio credentials a confirmed message is delivered directly. Without
# them WhatsApp opens on the phone with the message ready to send.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# MESSAGE_SENDS_PER_HOUR=10

# --- Payments ----------------------------------------------------------------
# Only Stripe test keys (sk_test_... or rk_test_...) are accepted; a live key
# is refused. Empty means every payment is simulated.
# STRIPE_SECRET_KEY=
# PAY_MAX_CENTS=5000

# --- Voice (optional) --------------------------------------------------------
# Without a key the phone's own voice is used.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# SPEECH_VOICE=minimax

# --- Supermemory (relationship-based memory graph) -------------------------
# GuideAI proxies Supermemory through this API so the key never ships inside
# the app bundle. Leave blank to run memory fully on-device: the app keeps its
# own local graph and simply does not sync.
# Create a key at https://console.supermemory.ai (keys look like sm_...).
SUPERMEMORY_API_KEY=
# Override only for a self-hosted instance, e.g. http://localhost:6767
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
