# `ios/` used to be Expo's generated native project and was ignored for that
# reason. It is now the actual SwiftUI app, so only build output is ignored.
ios/**/.build/
ios/**/DerivedData/
ios/**/*.xcuserdatad/
ios/**/xcuserdata/
# SwiftPM writes a 16MB index store here when a build flag is misparsed.
ios/**/-Xcc/
ios/GuideAI/
ios/GuideAI.xcodeproj/
ios/GuideAI.xcworkspace/
ios/Podfile
ios/Podfile.lock
ios/Podfile.properties.json
ios/.xcode.env
ios/.gitignore
.swiftpm/

# How2Sign (CC BY-NC 4.0) clips, keypoints and model outputs stay local
datasets/

# Model weights are downloaded at runtime, never committed
*.pt
*.pth
gateway/third_party/

# Expo CLI writes a tsconfig at whatever it thinks the project root is. In this
# workspace that lands here, but the only TypeScript project is apps/mobile.
/tsconfig.json
