{
  "name": "guideai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "cd apps/mobile && expo start",
    "web": "cd apps/mobile && expo start --web",
    "build:web": "npm --workspace apps/mobile run build:web",
    "typecheck": "npm --workspace apps/mobile run typecheck",
    "lint": "npm --workspace apps/mobile run lint",
    "doctor": "npm --workspace apps/mobile run doctor",
    "test:unit": "npm --workspace apps/mobile run test:unit",
    "build:desktop": "npm run build:web && npm --workspace apps/desktop run sync-web",
    "tunnel": "cd apps/mobile && expo start --tunnel",
    "ios": "cd apps/mobile && expo run:ios --device",
    "android": "cd apps/mobile && expo run:android --device",
    "demo": "cd apps/mobile && expo start --tunnel --no-dev --minify"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
